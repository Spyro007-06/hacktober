# Copy to .env and fill in. Never commit .env.
MODEL_MODE=online                 # online | offline
GEMINI_API_KEY=                   # never commit
GEMINI_MODEL=                     # required in online mode; no default. Google's docs list gemma-4-31b-it / gemma-4-26b-a4b-it (unverified here)
OLLAMA_URL=http://localhost:11434 # offline mode: must be a local address
OLLAMA_MODEL=                     # required in offline mode; no default (reported tag: gemma4:e4b, unverified)
STT_ENGINE=whisper                # whisper (local faster-whisper) is the only implemented engine; gemma/indic return 503
STT_MODEL_DIR=./data/models/whisper/small   # relative to backend/; install with scripts/download_stt_model.py
STT_CPU_THREADS=0                 # 0 = auto (physical cores, max 8)
STT_BEAM_SIZE=5
STT_TIMEOUT_S=120                 # per transcription request
MAX_AUDIO_MB=10                   # upload size limit (not in PRD)
MAX_AUDIO_S=300                   # audio duration limit (not in PRD)
TTS_ENGINE=none                   # none = text only (POST /api/tts answers 501); piper = local Piper process
TTS_PIPER_PYTHON=                 # piper only: python.exe of a separate venv that has piper-tts
TTS_VOICE_TA=                     # piper only: path to a Tamil .onnx voice
TTS_VOICE_EN=                     # piper only: path to an English .onnx voice (none installed yet)
TTS_TIMEOUT_S=30
TTS_MAX_CHARS=1500
AUDIO_CHUNK_S=30
MODEL_TIMEOUT_S=30
MAX_PHOTOS=3
MAX_PHOTO_MB=8                    # per image (not in PRD; upload safety limit)
DATA_DIR=./data                   # relative paths resolve against backend/; holds SQLite, uploads, departments.json, rules.json
WARD_BOUNDARIES=./data/wards.geojson   # P1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000   # front-end dev origins
LOG_LEVEL=INFO
# NOTE: WEASYPRINT_DLL_DIRECTORIES is NOT read from this file (WeasyPrint reads
# the process environment). It is optional: WeasyPrint already looks in
# C:\msys64\ucrt64\bin and C:\msys64\mingw64\bin. See README.md.
